{
  "name": "DiscoBot",
  "version": "1.0.0",
  "description": "",
  "main": "dist/bot.js",
  "type": "module",
  "scripts": {
    "start": "npm run build && concurrently \"npm run start:bot\" \"npm run start:web\"",
    "start:bot": "node dist/bot.js",
    "start:web": "node dist/web.js",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:mcp": "node dist/mcp/server.js",
    "start:all:bg": "npm run build && pm2 start dist/web.js --name \"discord-panel\" && pm2 start dist/bot.js --name \"discord-bot\"",
    "start:bot:bg": "pm2 start dist/bot.js --name \"discord-bot\"",
    "start:web:bg": "pm2 start dist/web.js --name \"discord-panel\"",
    "stop": "pm2 stop discord-bot",
    "stop:all": "pm2 stop all",
    "restart": "pm2 restart discord-bot",
    "restart:all": "pm2 restart all",
    "logs": "pm2 logs discord-bot",
    "logs:all": "pm2 logs",
    "status": "pm2 status",
    "delete": "pm2 delete discord-bot",
    "delete:all": "pm2 delete all",
    "stop:web": "pm2 stop discord-panel",
    "restart:web": "pm2 restart discord-panel",
    "logs:web": "pm2 logs discord-panel",
    "delete:web": "pm2 delete discord-panel"
  },
  "keywords": [],
  "author": "Adham Cabral",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-sqlite3": "^12.10.0",
    "discord.js": "^14.23.2",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "openai": "^6.3.0",
    "sharp": "^0.32.6",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
